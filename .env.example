# Configuración de NeXo Automatización de Correos
# Renombra este archivo a .env y completa tus datos

# Correo de Gmail remitente
GMAIL_USER=tu_correo@gmail.com

# Contraseña de aplicación de 16 caracteres generada en tu cuenta de Google
# (Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Nombre del remitente que verán los destinatarios
SENDER_NAME=NeXo Software

# Nombre o ruta del archivo de gestión en Excel
EXCEL_PATH=NeXo_Gestion_Prospectos_y_Correos.xlsx

# Rango de retraso aleatorio entre envíos en segundos (evita bloqueos y spam)
DELAY_MIN_SECONDS=45
DELAY_MAX_SECONDS=75
